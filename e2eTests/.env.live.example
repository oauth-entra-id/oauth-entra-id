# Copy this file to .env.live and fill in every value. .env.live is git-ignored.

# Where the example servers and the React demo run during the tests.
# Every server URL + /auth/callback must be a registered redirect URI of its app registrations.
EXPRESS_URL=http://localhost:3001
NESTJS_URL=http://localhost:3002
FASTIFY_URL=http://localhost:3003
HONOJS_URL=http://localhost:3004
REACT_FRONTEND_URL=http://localhost:5000

# App registrations (all three in the same tenant). The names match the first registration set the example servers use.
YELLOW1_AZURE_CLIENT_ID=
YELLOW1_AZURE_TENANT_ID=
YELLOW1_AZURE_CUSTOM_SCOPE=
YELLOW1_AZURE_CLIENT_SECRET=
YELLOW1_AZURE_EXPOSED_SCOPE=

RED1_AZURE_CLIENT_ID=
RED1_AZURE_TENANT_ID=
RED1_AZURE_CUSTOM_SCOPE=
RED1_AZURE_CLIENT_SECRET=
RED1_AZURE_EXPOSED_SCOPE=

BLUE1_AZURE_CLIENT_ID=
BLUE1_AZURE_TENANT_ID=
BLUE1_AZURE_CUSTOM_SCOPE=
BLUE1_AZURE_CLIENT_SECRET=
BLUE1_AZURE_EXPOSED_SCOPE=

# Test user (belongs to the tenant of the app registrations above)
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
