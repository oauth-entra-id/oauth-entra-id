{
  "name": "e2e-tests",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test": "pnpm -w run test:build && playwright test",
    "test:headed": "pnpm -w run test:build && playwright test --headed",
    "test:browser": "pnpm -w run test:build && playwright test \"/0[1-5]-\"",
    "test:browser:headed": "pnpm -w run test:build && playwright test \"/0[1-5]-\" --headed",
    "test:mobile": "pnpm -w run test:build && playwright test \"mobile-\"",
    "test:mobile:headed": "pnpm -w run test:build && playwright test \"mobile-\" --headed",
    "browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.1",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
