{
  "name": "oauth-entra-ad-monorepo",
  "private": true,
  "scripts": {
    "start": "turbo run start",
    "build": "turbo run build",
    "dev": "turbo run dev --filter=./examples/*",
    "format": "pnpm biome format",
    "lint": "pnpm biome lint",
    "check": "pnpm biome check",
    "check:fix": "pnpm biome check --fix",
    "typecheck": "turbo run typecheck",
    "test:build": "turbo run build --filter=oauth-entra-id --filter=\"server-*\"",
    "test": "pnpm --filter e2e-tests test",
    "test:headed": "pnpm --filter e2e-tests test:headed",
    "test:browser": "pnpm --filter e2e-tests test:browser",
    "test:browser:headed": "pnpm --filter e2e-tests test:browser:headed",
    "test:mobile": "pnpm --filter e2e-tests test:mobile",
    "test:mobile:headed": "pnpm --filter e2e-tests test:mobile:headed",
    "test:lite": "pnpm --filter e2e-tests test:lite",
    "test:package": "pnpm --filter e2e-tests test:package",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "husky": "^9.1.7",
    "turbo": "^2.11.11"
  },
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.18.0"
  }
}
