# Copy this file to .env (git-ignored) in the repository root. The example servers read it.
# The tenant setup these values come from is described in examples/README.md.

NODE_ENV=development

# Where the example servers and the React demo run. Every server URL + /auth/callback (browser login)
# and + /auth/mobile/callback (mobile login) must be a registered redirect URI of its app registration.
EXPRESS_URL=http://localhost:3001
EXPRESS_PORT=3001
NESTJS_URL=http://localhost:3002
NESTJS_PORT=3002
FASTIFY_URL=http://localhost:3003
FASTIFY_PORT=3003
HONOJS_URL=http://localhost:3004
HONOJS_PORT=3004
REACT_FRONTEND_URL=http://localhost:5000

# Encryption keys, 32 to 64 characters each. For example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
YELLOW_SECRET_KEY=
RED_SECRET_KEY=
BLUE_SECRET_KEY=

# App registrations, all three in the same tenant. Yellow is Express, red is NestJS and Fastify, blue is HonoJS.
# CUSTOM_SCOPE is the scope users sign in with (api://<client-id>/<scope name>), EXPOSED_SCOPE is api://<client-id>/.default.
YELLOW1_AZURE_CLIENT_ID=
YELLOW1_AZURE_TENANT_ID=
YELLOW1_AZURE_CUSTOM_SCOPE=
YELLOW1_AZURE_CLIENT_SECRET=
YELLOW1_AZURE_EXPOSED_SCOPE=

RED1_AZURE_CLIENT_ID=
RED1_AZURE_TENANT_ID=
RED1_AZURE_CUSTOM_SCOPE=
RED1_AZURE_CLIENT_SECRET=
RED1_AZURE_EXPOSED_SCOPE=

BLUE1_AZURE_CLIENT_ID=
BLUE1_AZURE_TENANT_ID=
BLUE1_AZURE_CUSTOM_SCOPE=
BLUE1_AZURE_CLIENT_SECRET=
BLUE1_AZURE_EXPOSED_SCOPE=

# Optional: a second set of the three app registrations (for example in another tenant).
# Leave it out completely, or fill in all fifteen values. When it is set, the demo shows a 1 / 2 switch to choose the registration.
# YELLOW2_AZURE_CLIENT_ID=
# YELLOW2_AZURE_TENANT_ID=
# YELLOW2_AZURE_CUSTOM_SCOPE=
# YELLOW2_AZURE_CLIENT_SECRET=
# YELLOW2_AZURE_EXPOSED_SCOPE=
# RED2_AZURE_CLIENT_ID=
# RED2_AZURE_TENANT_ID=
# RED2_AZURE_CUSTOM_SCOPE=
# RED2_AZURE_CLIENT_SECRET=
# RED2_AZURE_EXPOSED_SCOPE=
# BLUE2_AZURE_CLIENT_ID=
# BLUE2_AZURE_TENANT_ID=
# BLUE2_AZURE_CUSTOM_SCOPE=
# BLUE2_AZURE_CLIENT_SECRET=
# BLUE2_AZURE_EXPOSED_SCOPE=
